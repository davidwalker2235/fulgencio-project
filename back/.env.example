DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
POSTGRES_CONNECT_TIMEOUT_SECONDS=60
POSTGRES_CONNECT_RETRY_ATTEMPTS=5
POSTGRES_CONNECT_RETRY_BASE_SECONDS=1
POSTGRES_CONNECT_MAX_TOTAL_SECONDS=45
LITELLM_IMAGE_API_BASE=https://your-litellm-gateway.example.com
LITELLM_IMAGE_API_KEY=sk-your-image-virtual-key
LITELLM_IMAGE_MODEL=gpt-image-2
